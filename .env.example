# URL pública da aplicação (usada em metadata, sitemap e robots)
APP_URL=http://localhost:5173

# Token de leitura (v4) do TMDB — https://www.themoviedb.org/settings/api
# Fica apenas no servidor: nunca use o prefixo NEXT_PUBLIC_ aqui.
TMDB_TOKEN=your_token

# Segredo usado para assinar o JWT de sessão
JWT_SECRET=super-secret-key

# String de conexão do PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/streamly
